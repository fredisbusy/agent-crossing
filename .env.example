# Database
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent_crossing

# LLM backend preset: ollama | google_ai_studio
LLM_BACKEND=ollama
LLM_TIMEOUT_SECONDS=30

# Required only when LLM_BACKEND=google_ai_studio
GOOGLE_AI_STUDIO_API_KEY=

# 선택: 생성 모델·엔드포인트를 프리셋 대신 직접 지정 (OpenAI 호환 게이트웨이 예시)
# LLM_MODEL=openai/gpt-5.6-luna
# LLM_BASE_URL=https://api.byfred.io/v1
# LLM_API_KEY=${FRED_MODEL_API_KEY}
# LLM_REASONING_EFFORT=none
# 선택: 임베딩만 다른 엔드포인트로 (없으면 LLM_BASE_URL·LLM_API_KEY)
# EMBEDDING_MODEL=gemini/gemini-embedding-001
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# EMBEDDING_API_KEY=${GOOGLE_AI_STUDIO_API_KEY}

# Runtime tick scheduler interval in real seconds
WORLD_TICK_INTERVAL_SECONDS=1.0
