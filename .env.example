# Database
DATABASE_URL=postgresql+psycopg://agent:agent@127.0.0.1:5432/agent_crossing
PRISMA_DATABASE_URL=postgresql://agent:agent@127.0.0.1:5432/agent_crossing
POSTGRES_PASSWORD=agent

# LLM backend preset: ollama | google_ai_studio
LLM_BACKEND=ollama
LLM_TIMEOUT_SECONDS=120

# Required only when LLM_BACKEND=google_ai_studio
GOOGLE_AI_STUDIO_API_KEY=

# Runtime tick scheduler interval in real seconds
WORLD_TICK_INTERVAL_SECONDS=1.0
# Game seconds advanced per tick while dialogue or local LLM cognition is active
WORLD_COGNITIVE_TIME_STEP_SECONDS=60

# Max concurrent plan-generation LLM calls. MUST match (or stay below) the
# LLM backend's actual parallel-request capacity — for Ollama, the running
# `llama-server`'s `-np` flag (set via `OLLAMA_NUM_PARALLEL`). Exceeding it
# makes the server queue overflow requests past LLM_TIMEOUT_SECONDS, which
# surfaces as a planning_error. `launchctl setenv OLLAMA_NUM_PARALLEL` is
# session-scoped and does not survive a reboot/logout, so re-check
# `ps aux | grep llama-server` for the live `-np` value after any restart.
PLAN_GENERATION_MAX_CONCURRENCY=4

# Autosave the active session every N ticks (0 disables periodic autosave)
SESSION_AUTOSAVE_TICK_INTERVAL=50
