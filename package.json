{
  "name": "agent-crossing",
  "private": true,
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter @agent-crossing/backend dev",
    "dev:simulation": "uv run --project packages/backend python packages/backend/src/run_agent_loop_simulation.py",
    "test:backend": "uv run --project packages/backend pytest -c packages/backend/pyproject.toml packages/backend/tests",
    "sync": "uv sync --project packages/backend",
    "build": "pnpm -r build",
    "test": "pnpm test:backend && pnpm --filter @agent-crossing/frontend test",
    "db:validate": "pnpm --filter @agent-crossing/database build",
    "db:migrate": "pnpm --filter @agent-crossing/database migrate:deploy",
    "db:status": "pnpm --filter @agent-crossing/database migrate:status"
  },
  "devDependencies": {
    "prettier": "^3.0.0"
  }
}
